  <vhdl appearance="logisim_evolution" name="logic4">--library and package
library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;

--entity
entity logic4 is
     port(
          a,b,c,d    :in  std_logic;
          out1,out2  :out std_logic
     );
end entity logic4;

--architecture
architecture bhv of logic4 is
begin
     out1 &lt;= a and b and c and d;   -- 4-input AND
     out2 &lt;= a or b or c or d;      -- 4-input OR
end architecture bhv;
</vhdl>
  <vhdl appearance="logisim_evolution" name="mux8_1">--library and package
library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;

--entity
entity mux8_1 is
     port(
          d0,d1,d2,d3,d4,d5,d6,d7 :in  std_logic;
          ch                      :in  std_logic_vector(2 downto 0);
          data                    :out std_logic
     );
end entity mux8_1;

--architecture
architecture bhv of mux8_1 is
begin
     process(d0,d1,d2,d3,d4,d5,d6,d7,ch)
     begin
          case ch is
               when "000"  =&gt; data &lt;= d0;
               when "001"  =&gt; data &lt;= d1;
               when "010"  =&gt; data &lt;= d2;
               when "011"  =&gt; data &lt;= d3;
               when "100"  =&gt; data &lt;= d4;
               when "101"  =&gt; data &lt;= d5;
               when "110"  =&gt; data &lt;= d6;
               when "111"  =&gt; data &lt;= d7;
               when others =&gt; data &lt;= '0';
          end case;
     end process;
end architecture bhv;
</vhdl>
  <vhdl appearance="logisim_evolution" name="letter_led">--library and package
library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;

--entity
-- display(7 downto 0) = a b c d e f g dp
entity letter_led is
     port(
          en      :in  std_logic;
          sel     :in  std_logic_vector(2 downto 0);
          display :out std_logic_vector(7 downto 0)
     );
end entity letter_led;

--architecture
architecture bhv of letter_led is
begin
     process(en,sel)
     begin
          if en='0' then
               display &lt;= "ZZZZZZZZ";
          else
               case sel is
                    when "000"  =&gt; display &lt;= "11101110";  -- A
                    when "001"  =&gt; display &lt;= "00111110";  -- b
                    when "010"  =&gt; display &lt;= "10011100";  -- C
                    when "011"  =&gt; display &lt;= "01111010";  -- d
                    when "100"  =&gt; display &lt;= "10001110";  -- F
                    when "101"  =&gt; display &lt;= "11110110";  -- g
                    when others =&gt; display &lt;= "00000000";  -- off
               end case;
          end if;
     end process;
end architecture bhv;
</vhdl>
  <vhdl appearance="logisim_evolution" name="vote25">--library and package
library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;

--entity
entity vote25 is
     port(
          vt     :in  std_logic_vector(25 downto 1);
          result :out std_logic
     );
end entity vote25;

--architecture
architecture bhv of vote25 is
begin
     process(vt)
     variable sum:integer range 0 to 25;
     begin
          sum := 0;
          for i in 1 to 25 loop
               if (vt(i)='1') then
                    sum := sum+1;
               end if;
          end loop;
          if sum &gt;= 13 then      -- more than half of 25
               result &lt;= '1';
          else
               result &lt;= '0';
          end if;
     end process;
end architecture bhv;
</vhdl>
  <vhdl appearance="logisim_evolution" name="count13_led">--library and package
library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_arith.all;
use ieee.std_logic_unsigned.all;

--entity
-- display(7 downto 0) = a b c d e f g dp
entity count13_led is
     port(
          en      :in  std_logic;
          vt      :in  std_logic_vector(13 downto 1);
          display :out std_logic_vector(7 downto 0)
     );
end entity count13_led;

--architecture
architecture bhv of count13_led is
begin
     process(en,vt)
     variable sum:integer range 0 to 15;
     begin
          sum := 0;
          for i in 1 to 13 loop
               if (vt(i)='1') then
                    sum := sum+1;
               end if;
          end loop;
          if en='0' then
               display &lt;= "00000000";               -- display off
          else
               case sum is
                    when 0      =&gt; display &lt;= "11111100";  -- 0
                    when 1      =&gt; display &lt;= "01100000";  -- 1
                    when 2      =&gt; display &lt;= "11011010";  -- 2
                    when 3      =&gt; display &lt;= "11110010";  -- 3
                    when 4      =&gt; display &lt;= "01100110";  -- 4
                    when 5      =&gt; display &lt;= "10110110";  -- 5
                    when 6      =&gt; display &lt;= "10111110";  -- 6
                    when 7      =&gt; display &lt;= "11100000";  -- 7
                    when 8      =&gt; display &lt;= "11111110";  -- 8
                    when 9      =&gt; display &lt;= "11110110";  -- 9
                    when 10     =&gt; display &lt;= "11101110";  -- A
                    when 11     =&gt; display &lt;= "00111110";  -- b
                    when 12     =&gt; display &lt;= "10011100";  -- C
                    when 13     =&gt; display &lt;= "01111010";  -- d
                    when 14     =&gt; display &lt;= "10011110";  -- E
                    when 15     =&gt; display &lt;= "10001110";  -- F
                    when others =&gt; display &lt;= "00000000";
               end case;
          end if;
     end process;
end architecture bhv;
</vhdl>
